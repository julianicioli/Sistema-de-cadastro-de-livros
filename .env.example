# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > Data API / API Keys, ou botão "Connect")
# A URL termina em .supabase.co (sem /rest/v1/ no final)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "publishable" (sb_publishable_...) ou a "anon public". NUNCA a service_role/secret.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publishable-aqui
